# MySQL — relational store for users, roles, audit logs
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=cms_db

# MongoDB — document store for articles and content metadata
MONGODB_URI=mongodb://localhost:27017/cms_content
# For Atlas use: mongodb+srv://user:pass@cluster.mongodb.net/cms_content

# Auth — stateless JWT
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=7d

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
